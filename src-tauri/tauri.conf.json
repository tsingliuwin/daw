{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daw",
  "version": "0.1.3",
  "identifier": "com.meetcoding.daw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "寒鸦数据工作台",
        "width": 1200,
        "height": 768,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0a0b",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4MUVGRjRCQUU5MzY5ODcKUldTSGFaT3VTLzhlcU1EV0VJUVVOTmR6YzM3cTF6b1dwSTFrZGNIblk3Yk0vRW1xN2FCUEFseEoK",
      "endpoints": [
        "https://raw.githubusercontent.com/tsingliuwin/daw/main/updates/latest.json"
      ]
    }
  }
}
