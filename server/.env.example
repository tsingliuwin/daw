# AIOA 工作台服务端配置
# 复制此文件为 .env 并填入实际值。

# JWT 签发密钥（随机长字符串，务必修改）
JWT_SECRET=change-me-to-a-random-secret

# 服务名（客户端连接后显示）
SERVER_NAME=AIOA 工作台

# LLM Provider 列表（JSON 数组，和客户端 settings.json 的 providers 结构一致）
LLM_PROVIDERS=[]

# 搜索服务配置
SEARCH_ENGINE=exa
SEARCH_API_KEY=

# 允许登录的用户列表（JSON 数组，首期明文密码，后续改 hash）
USERS=[{"username":"admin","password":"admin"}]

# 服务端口（本地开发用，云函数部署时由平台决定）
PORT=3000
